! Portable bcc Fe SCF input template for the [103] strain structure workflow.
&control
  calculation = 'scf'
  prefix = 'pwscf'
  pseudo_dir = './pseudopotentials'
  outdir = './work'
  tstress = .true.
  tprnfor = .true.
  wf_collect = .true.
  disk_io = 'low'
  verbosity = 'high'
/
&system
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 64.0
  ecutrho = 782.0
  occupations = 'smearing'
  smearing = 'm-p'
  degauss = 0.01
  nspin = 2
  starting_magnetization(1) = 3.0
/
&electrons
  mixing_beta = 0.1
  conv_thr = 1.d-10
/
ATOMIC_SPECIES
Fe   55.845000  Fe.pbe-spn-rrkjus_psl.0.2.1.UPF

ATOMIC_POSITIONS {crystal}
Fe      0.0000000000     0.0000000000     0.0000000000
K_POINTS {automatic}
8 8 8 0 0 0
CELL_PARAMETERS angstrom
  -1.4340702353     1.4340702353     1.4340702353
   1.4340702353    -1.4340702353     1.4340702353
   1.4340702353     1.4340702353    -1.4340702353
